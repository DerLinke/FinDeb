CACHE_FILE = os.path.join(CACHE_DIR, "cache.json")
APPIMAGE_DIR = os.path.expanduser("~/Applications")

def is_in_venv():
    return sys.prefix != sys.base_prefix

def check_module(name):
    return importlib.util.find_spec(name) is not None

def console_print(text):
    if check_module("rich"):
        from rich.console import Console
        Console().print(text)
    else:
        print(text)

def run_sudo(command):
    console_print(f"[bold yellow]󰚌 Führe aus:[/bold yellow] sudo {' '.join(command)}")
    return subprocess.run(["sudo"] + command)

def load_config():
    default_config = {
        "enabled_sources": ["apt", "extrepo", "deb-get", "flatpak", "appimage"],
        "ignored_packages": [],
        "cache_ttl_hours": 12
    }
    if not os.path.exists(CONFIG_DIR):
        os.makedirs(CONFIG_DIR)
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                config = json.load(f)
                # Migration: Alte Configs ergänzen
                for k, v in default_config.items():
                    if k not in config: config[k] = v
                return config
        except Exception:
            pass
    return default_config

def get_cache():
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_cache(cache):
    if not os.path.exists(CACHE_DIR):
        os.makedirs(CACHE_DIR)
    try:
        with open(CACHE_FILE, "w") as f:
            json.dump(cache, f)
    except Exception:
        pass

def clear_cache():
    if os.path.exists(CACHE_FILE):
        os.remove(CACHE_FILE)
    console_print("[green]Cache geleert.[/green]")

def get_version_key(v_str):
    try:
        return version.parse(v_str)
    except Exception:
        return version.parse("0.0.0")

def group_packages(all_results, query):
    # Gruppierung & Filterung
    final_list = []
    grouped = {}
    from difflib import SequenceMatcher
    config = load_config()
    ignored = config.get("ignored_packages", [])
    
    for res in all_results:
        raw_name = res["name"].replace(":", "").split("(")[0].strip()
        name_key = raw_name.lower()
        
        # Exclusion Criteria
        if any(ign.lower() in name_key for ign in ignored):
            continue
            
        if name_key not in grouped: grouped[name_key] = []
        grouped[name_key].append(res)
        
    for name_key, variants in grouped.items():
        # Innerhalb der Varianten sortieren: Neueste Version oder bevorzugte Quellen zuerst
        variants.sort(key=lambda x: get_version_key(str(x.get("version", "0"))), reverse=True)
        
        max_score = max(v.get("score", 30) for v in variants)
        display_name = variants[0]["name"].replace(":", "").split("(")[0].strip()
        
        # Scoring-Logik verfeinern
        if query.lower() == name_key: 
            max_score += 100
        elif name_key.startswith(query.lower()): 
            max_score += 50
        
        # Fuzzy Match Score (difflib)
        ratio = SequenceMatcher(None, query.lower(), name_key).ratio()
        max_score += int(ratio * 40)
        
        final_list.append({
            "display_name": display_name,
            "variants": variants,
            "score": max_score,
            "description": variants[0]["description"]
        })

    final_list.sort(key=lambda x: (-x["score"], x["display_name"]))
    return final_list[:35]

def search(query):
    if not is_in_venv() and os.path.exists(VENV_PYTHON):
        os.execv(VENV_PYTHON, [VENV_PYTHON, os.path.abspath(__file__)] + sys.argv[1:])
        return

    from rich.console import Console
    from rich.table import Table
    from rich.live import Live
    from rich.spinner import Spinner
    import questionary
    import time
    
    config = load_config()
    enabled = config.get("enabled_sources", [])
    console = Console()

    # Cache Check (TTL aus Config)
    cache = get_cache()
    current_time = time.time()
    cache_entry = cache.get(query.lower())
    ttl_seconds = config.get("cache_ttl_hours", 12) * 3600
    
    all_results = []
    if ttl_seconds > 0 and cache_entry and (current_time - cache_entry.get("timestamp", 0)) < ttl_seconds:
        all_results = cache_entry.get("results", [])
    
    if not all_results:
        engines = []
        source_map = {"apt": "AptSource", "extrepo": "ExtRepoSource", "deb-get": "DebGetSource", "flatpak": "FlatpakSource", "snap": "SnapSource", "appimage": "AppImageSource", "pipx": "PipxSource", "pkcon": "PkconSource", "pacman": "PacmanSource", "npm": "NpmSource"}
        
        for key, class_name in source_map.items():
            if key in enabled:
                try:
                    module = importlib.import_module(f"sources.{key.replace('-', '_')}")
                    cls = getattr(module, class_name); engines.append(cls())
                except ImportError: pass

        if not engines:
            console_print("[yellow]Keine Quellen aktiv. Bitte 'findeb --setup' ausführen.[/yellow]"); return

        with Live(Spinner("dots", text=f"Suche nach '{query}'..."), refresh_per_second=10, console=console) as live:
            with ThreadPoolExecutor() as executor:
                futures = [executor.submit(engine.search, query) for engine in engines]
                for f in futures: all_results.extend(f.result())
            live.update("")
            
        if all_results:
            cache[query.lower()] = {"timestamp": current_time, "results": all_results}
            save_cache(cache)

    if not all_results:
        console_print("[red]Keine Treffer.[/red]"); return

    display_list = group_packages(all_results, query)
    
    # Definition der Branding-Farben für die Tabelle
    BRAND_BLUE = "#0000FF"
    BRAND_MAGENTA = "#96009F"

    table = Table(box=None, header_style=f"bold {BRAND_BLUE}", collapse_padding=True)
    table.add_column("#", justify="right", style="dim", width=3)
    table.add_column("Paket", style="bold white", width=25)
    table.add_column("Quellen", style=BRAND_MAGENTA)
    table.add_column("Top-Version", style="green")
    table.add_column("Beschreibung", style="dim")

    def get_source_label(v):
        return f"{v['source']} ({v['format']})" if v.get("format") else v["source"]

    for idx, item in enumerate(display_list, 1):
        sources = ", ".join(sorted(set(get_source_label(v) for v in item["variants"])))
        top_v = item["variants"][0]["version"]
        table.add_row(str(idx), item["display_name"], sources, str(top_v)[:15], item["description"][:60])

    console_print(table)
    show_footer()

    choices = [f"{str(idx).rjust(2)} │ {item['display_name'].ljust(25)} │ {len(item['variants'])} Optionen" for idx, item in enumerate(display_list, 1)]
    choices.append("Abbrechen")
    
    while True:
        selected_pkg = questionary.select("Paket wählen:", choices=choices,
                                         style=questionary.Style([
                                             ('highlighted', f'fg:white bg:{BRAND_BLUE} bold'),
                                             ('pointer', f'fg:{BRAND_BLUE} bold'),
                                             ('answer', f'fg:{BRAND_BLUE} bold')
                                         ])).ask()
        if not selected_pkg or "Abbrechen" in selected_pkg: return
        pkg_idx = int(selected_pkg.split("│")[0].strip()) - 1
        target_item = display_list[pkg_idx]

        if len(target_item["variants"]) > 1:
            # Detaillierte Auswahl der Variante
            v_choices = []
            for v in target_item["variants"]:
                v_choices.append(f"{get_source_label(v).ljust(25)} │ Version: {str(v['version']).ljust(15)} │ {v['name']}")
            
            v_choices.append("Zurück")
            v_selected = questionary.select("Quelle/Version wählen:", choices=v_choices,
                                           style=questionary.Style([
                                               ('highlighted', f'fg:white bg:{BRAND_MAGENTA} bold'), 
                                               ('pointer', f'fg:{BRAND_MAGENTA} bold'),
                                               ('answer', f'fg:{BRAND_MAGENTA} bold')
                                           ])).ask()
            if not v_selected: return
            if v_selected == "Zurück": continue
            v_idx = v_choices.index(v_selected); final_pkg = target_item["variants"][v_idx]
        else: final_pkg = target_item["variants"][0]
        
        install_pkg(final_pkg)
        break

def install_pkg(pkg):
    from rich.console import Console
    BRAND_BLUE = "#0000FF"
    console = Console(); console.print(f"\n[bold {BRAND_BLUE}] Installiere {pkg['name'].replace(':', '')} via {pkg['source']}...[/bold {BRAND_BLUE}]")
    if pkg["source"] == "extrepo":
        run_sudo(["extrepo", "enable", pkg.get("repo_id", pkg["name"].replace(":", ""))])
        run_sudo(["apt", "update"]); run_sudo(["apt", "install", "-y", pkg["name"].replace(":", "")])
    elif pkg["source"] in ["appimage", "github"]:
        from installer_github import install_github; install_github(pkg)
    elif pkg["source"] == "npm":
        try: subprocess.run(pkg["install_cmd"], check=True)
        except: run_sudo(pkg["install_cmd"])
    else: run_sudo(pkg["install_cmd"])

